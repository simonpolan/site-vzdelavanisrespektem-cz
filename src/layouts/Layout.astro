---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getRootPath } from '../paths';
import { HIDE_FROM_SEARCH, SITE_NAME } from '../site';

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const rootPath = getRootPath(Astro.url.pathname, Astro.routePattern);
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {HIDE_FROM_SEARCH && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${rootPath}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <Header rootPath={rootPath} />
    <main id="obsah">
      <slot />
    </main>
    <Footer rootPath={rootPath} />
  </body>
</html>
