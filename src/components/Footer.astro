---
import { SITE_AUTHOR } from '../site';

const currentYear = new Date().getFullYear();
---

<footer class="container">
  <p>© {currentYear} {SITE_AUTHOR}</p>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 2rem;
  }

  p {
    margin: 0;
  }
</style>
